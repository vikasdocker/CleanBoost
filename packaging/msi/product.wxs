<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="CleanBoost"
      Manufacturer="JS BlueFlutex"
      Version="0.2.0"
      UpgradeCode="8318b96a-85f5-4bcc-884d-a7252985c17b"
      Language="1033"
      Scope="perMachine"
      InstallerVersion="500"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of CleanBoost is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="CleanBoostFeature" Title="CleanBoost" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="cmp_StartShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CleanBoost" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="PROGRAMSMENUDIR" Name="CleanBoost" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <Component Id="cmp_StartShortcut" Directory="PROGRAMSMENUDIR" Guid="*">
      <Shortcut
          Id="CleanBoostStartMenuShortcut"
          Name="CleanBoost"
          Description="CleanBoost - safe Windows cleanup and one-click boost"
          WorkingDirectory="INSTALLFOLDER"
          Target="[INSTALLFOLDER]CleanBoost.exe" />
      <RemoveFolder Id="CleanBoostMenuRemoval" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\CleanBoost"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>