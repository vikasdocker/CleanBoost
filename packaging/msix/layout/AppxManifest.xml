<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    IgnorableNamespaces="uap rescap desktop">

    <Identity
        Name="CleanBoost"
        Publisher="CN=CleanBoostDev"
        Version="0.2.0.0"
        ProcessorArchitecture="x64" />

    <Properties>
        <DisplayName>CleanBoost</DisplayName>
        <PublisherDisplayName>JS BlueFlutex</PublisherDisplayName>
        <Description>Safe Windows cleanup and one-click boost: temp files, browser caches, community rules, services and startup tuning.</Description>
        <Logo>Assets\StoreLogo.png</Logo>
    </Properties>

    <Resources>
        <Resource Language="en-us" />
    </Resources>

    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26340.0" />
    </Dependencies>

    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>

    <Applications>
        <Application Id="App" Executable="CleanBoost.exe" EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements
                DisplayName="CleanBoost"
                Square150x150Logo="Assets\Square150x150Logo.png"
                Square44x44Logo="Assets\Square44x44Logo.png"
                Description="Safe Windows cleanup and one-click boost."
                BackgroundColor="transparent" />
            <Extensions>
                <desktop:Extension Category="windows.fullTrustProcess" Executable="CleanBoost.exe">
                    <desktop:FullTrustProcess />
                </desktop:Extension>
            </Extensions>
        </Application>
    </Applications>
</Package>