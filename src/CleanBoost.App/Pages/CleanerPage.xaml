<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanBoost.App.Pages.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CleanBoost.App.Pages">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="32,20,32,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Cleaner" />
            <TextBlock Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="Scan previews junk that is safe to remove. Deletions go to the Recycle Bin first — nothing is permanent." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ToggleSwitch x:Name="CommunityToggle"
                          Header="Community rules"
                          OffContent="winapp2.ini off"
                          OnContent="winapp2.ini on"
                          Toggled="CommunityToggle_Toggled" />
            <TextBlock x:Name="CommunityStatus"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="2" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ScanButton" Style="{ThemeResource AccentButtonStyle}" Content="Scan" Click="ScanButton_Click" />
                <Button x:Name="CleanButton" Content="Clean selected" IsEnabled="False" Click="CleanButton_Click" />
                <Button x:Name="CleanAllButton" Content="Clean all found" IsEnabled="False" Click="CleanAllButton_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="CancelButton_Click" />
                <ProgressBar x:Name="CleanProgress" Width="240" Visibility="Collapsed" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SelectAllButton" Content="Select all" IsEnabled="False" Click="SelectAllButton_Click" />
                <Button x:Name="ClearSelectionButton" Content="Clear selection" IsEnabled="False" Click="ClearSelectionButton_Click" />
                <TextBlock x:Name="SelectionSummary"
                           VerticalAlignment="Center"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SummaryText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{ThemeResource BodyTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Live cleanup activity. Stays up after the run finishes so the result is readable. -->
        <Border Grid.Row="3" x:Name="CleanLivePanel" Visibility="Collapsed"
                Padding="12" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource TextFillColorSecondaryBrush}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="CleanLiveSummary"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap" />

                <ListView Grid.Row="1" x:Name="DeleteLogList" SelectionMode="None" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DeleteLogModel">
                            <Grid ColumnSpacing="12" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind PathText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind CategoryText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind OutcomeText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           MinWidth="70" TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <InfoBar x:Name="ScanInfo" Grid.Row="4" IsOpen="False" />
        <InfoBar x:Name="CleanInfo" Grid.Row="5" IsOpen="False" />

        <ListView x:Name="CategoryList" Grid.Row="6" SelectionMode="Multiple"
                  SelectionChanged="CategoryList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CategoryModel">
                    <Grid ColumnSpacing="12" Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Icon}" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Description}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" MaxLines="2" />
                            <TextBlock Text="Community rule"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{x:Bind IsCommunity, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                            <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ItemsText, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>