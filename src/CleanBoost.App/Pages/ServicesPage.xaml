<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanBoost.App.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CleanBoost.App.Pages">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </Page.Resources>

    <Grid Padding="32,20,32,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Services" />
            <TextBlock Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Choose which services start with Windows. Boot and system drivers are shown but locked." />
        </StackPanel>

        <TextBox x:Name="ServiceFilter"
                 Grid.Row="1"
                 Width="320"
                 HorizontalAlignment="Left"
                 PlaceholderText="Filter services"
                 TextChanged="ServiceFilter_TextChanged" />

        <TextBlock x:Name="AdminNote"
                   Grid.Row="2"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorCautionBrush}"
                   Text="Changes need administrator mode — use the banner button above."
                   Visibility="{x:Bind IsElevated, Mode=OneTime, Converter={StaticResource InvBoolToVis}}" />

        <ListView Grid.Row="3" x:Name="ServiceList" SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ServiceModel">
                    <Grid ColumnSpacing="12" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Name}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  MinWidth="120"
                                  IsEnabled="{x:Bind IsMutable}"
                                  Visibility="{x:Bind IsMutable, Mode=OneTime, Converter={StaticResource BoolToVis}}"
                                  SelectedIndex="{x:Bind StateIndex, Mode=OneTime}"
                                  SelectionChanged="ServiceStartMode_Changed"
                                  HorizontalAlignment="Right">
                            <ComboBoxItem Content="Automatic" />
                            <ComboBoxItem Content="Manual" />
                            <ComboBoxItem Content="Disabled" />
                        </ComboBox>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   MinWidth="120" TextAlignment="Right"
                                   Text="{x:Bind ModeText}"
                                   Visibility="{x:Bind IsMutable, Mode=OneTime, Converter={StaticResource InvBoolToVis}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar x:Name="ServicesInfo" Grid.Row="3" VerticalAlignment="Top" IsOpen="False" />
    </Grid>
</Page>