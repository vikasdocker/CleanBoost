<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanBoost.App.Pages.BoosterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CleanBoost.App.Pages">

    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="32,20,32,20" RowSpacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Booster" />
            <TextBlock Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="Light does only fully safe work. Turbo adds three extra steps behind an explicit consent — including emptying the Recycle Bin." />
        </StackPanel>

        <ToggleSwitch Grid.Row="1" x:Name="TurboSwitch"
                      Header="Turbo mode"
                      OffContent="Light" OnContent="Turbo"
                      Toggled="TurboSwitch_Toggled" />

        <StackPanel Grid.Row="2" x:Name="TurboWarningPanel" Visibility="Collapsed" Spacing="8">
            <TextBlock Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       Text="Turbo permanently empties the Recycle Bin — that is the one irreversible step in the whole app. It also flushes DNS and trims working sets, which can cause a brief pause while apps page memory back in under load." />
            <CheckBox x:Name="TurboConsent" Content="I understand — include the Turbo steps" IsChecked="False" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="8">
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Steps" />
            <TextBlock x:Name="PlanSummaryText"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ListView Grid.Row="4" x:Name="StepsList" SelectionMode="None" Height="220">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:BoostStepModel">
                    <Grid ColumnSpacing="12" Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Turbo"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{x:Bind IsTurboOnly, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Description}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="5" Spacing="8">
            <InfoBar x:Name="BoostInfo" IsOpen="False" />
            <TextBlock x:Name="SummaryText"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <Button x:Name="RunBoostButton" Style="{ThemeResource AccentButtonStyle}" Content="Apply boost" Click="RunBoostButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="CancelBoostButton_Click" />
            <ProgressRing x:Name="BoostProgress" IsActive="False" Width="24" Height="24" />
        </StackPanel>
    </Grid>
</Page>