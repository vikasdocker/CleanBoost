<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CleanBoost.App.Pages.BoosterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CleanBoost.App.Pages">

    <Grid Padding="32,20,32,20" RowSpacing="16" MaxWidth="720" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Booster" />
            <TextBlock Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Apply a one-click boost. Light is fully safe; Turbo adds a RAM flush." />
        </StackPanel>

        <ToggleSwitch Grid.Row="1" x:Name="TurboSwitch"
                      Header="Turbo mode"
                      OffContent="Light" OnContent="Turbo"
                      Toggled="TurboSwitch_Toggled" />

        <StackPanel Grid.Row="2" x:Name="TurboWarningPanel" Visibility="Collapsed" Spacing="8">
            <TextBlock Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       Text="Turbo flushes unused memory by trimming working sets. It is not dangerous, but you may notice a brief pause while apps page memory back in under load." />
            <CheckBox x:Name="TurboConsent" Content="I understand, include the RAM flush in Turbo" IsChecked="False" />
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Steps" />

        <ListView Grid.Row="4" x:Name="StepsList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:BoostStepModel">
                    <StackPanel Spacing="2" Margin="0,6">
                        <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Description}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
            <Button x:Name="RunBoostButton" Style="{ThemeResource AccentButtonStyle}" Content="Apply boost" Click="RunBoostButton_Click" />
            <ProgressRing x:Name="BoostProgress" IsActive="False" Width="24" Height="24" />
        </StackPanel>
        <TextBlock Grid.Row="6" x:Name="SummaryText"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
    </Grid>
</Page>